# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` itself is git-ignored -- never commit it.
# ---------------------------------------------------------------------------

# ===== Storage =====
CHROMA_DIR=storage/chroma_db
CHROMA_COLLECTION=qld_rr_docs

# ===== Embeddings =====
# Small + fast (default). all-mpnet-base-v2 is stronger but 5x slower.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# ===== Local LLM (Ollama) =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Model used by the evaluation scripts (can be larger than the serving model)
EVAL_OLLAMA_MODEL=qwen2.5:3b

# ===== Retrieval defaults =====
RETRIEVER_K=6
FETCH_K=80
PER_CHUNK=360
TRIM_CTX=1200
THR=0.20
RERANK=true
CE_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ===== Agent =====
MAX_AGENT_STEPS=4

# ===== HTTP API =====
API_HOST=127.0.0.1
API_PORT=8008
# Comma separated. Use your real GUI origin in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave empty to disable auth; set a long random string when exposed publicly.
SERVE_API_KEY=

# ===== LangSmith (optional observability) =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=qld-agentic-rag
